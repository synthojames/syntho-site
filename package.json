{
  "name": "syntho-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Personal site for syntho.moe",
  "engines": {
    "node": ">=22.23.4"
  },
  "packageManager": "pnpm@12.20.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm format:check && pnpm lint && pnpm check && pnpm build"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.5",
    "astro": "7.4.12",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@eslint/js": "10.0.1",
    "@types/three": "0.187.0",
    "eslint": "10.15.0",
    "eslint-plugin-astro": "3.2.1",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  }
}
